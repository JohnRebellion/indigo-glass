# Local builds
build/
*.o
*.so
*.bak

# OS artifacts
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~

# Test scratch
/tmp/

# Cursor build artifacts
cursor/.work/
cursor/out/

# Browser theme cache
browser/edge-theme/**/Cached Theme.pak

# GRUB QEMU preview build artifacts
/iso/
*.iso

# Python bytecode cache (tokens/codegen.py)
__pycache__/
*.pyc

# Session scratch — machine-local resume notes, not repo state
.session-state/

# Live-audit capture output. shoot-ours.mjs / shoot-reference.mjs regenerate
# these on demand (46 reference crops from neobrutalism.dev + 52 of ours,
# plus the per-section montages), so ~5MB per run does not belong in history.
# The findings live in the synthesis docs and in docs/OUTLINE-SWEEP-*.md.
research-reports/neobrutalism-live-audit-*/

# Stylus profile snapshots taken by scripts/style-check/stylusapply.mjs before
# it updates a browser profile. Machine-local recovery data, not repo state.
backups/stylus/

# Generated Stylus import bundle — rebuilt from browser/stylus/**/*.user.css
# by the snippet in scripts/style-check/README.md. Not repo state.
browser/stylus/out/

# Concept renders for the fastfetch brand mark. mk_svg*.py / ship*.py in the same
# directory regenerate them (122 PNG/SVG, ~2.3 MB per pass). The findings live in
# REPORT.md and 03-INSPECTION.md, which are tracked.
research-reports/sage-ink-mark-*/renders/
