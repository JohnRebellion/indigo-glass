    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#6B7280"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#F8F8F8"
            }
        },
        {
            "name": "Variable language (this/self)",
            "scope": [
                "variable.language",
                "variable.language.this"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#89A889"
            }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "constant.language",
                "constant.numeric",
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#89A889"
            }
        },
        {
            "name": "Boolean / null",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": {
                "foreground": "#89A889"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted"
            ],
            "settings": {
                "foreground": "#3FFABB"
            }
        },
        {
            "name": "String escape",
            "scope": [
                "constant.character.escape",
                "string.regexp"
            ],
            "settings": {
                "foreground": "#FBBF24"
            }
        },
        {
            "name": "Template expression punctuation",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": {
                "foreground": "#C0E3C0"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new"
            ],
            "settings": {
                "foreground": "#C0E3C0"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "punctuation.separator"
            ],
            "settings": {
                "foreground": "#A2B0FF"
            }
        },
        {
            "name": "Storage (var/let/const/function/class)",
            "scope": [
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#C0E3C0"
            }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function",
                "meta.definition.method entity.name.function"
            ],
            "settings": {
                "foreground": "#FBBF24"
            }
        },
        {
            "name": "Class / Type",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#89A889"
            }
        },
        {
            "name": "Namespace / Module",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "support.module"
            ],
            "settings": {
                "foreground": "#89A889"
            }
        },
        {
            "name": "Decorator",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#FBBF24"
            }
        },
        {
            "name": "Property / member",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.property.object",
                "support.variable.property"
            ],
            "settings": {
                "foreground": "#F8F8F8"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#C0E3C0"
            }
        },
        {
            "name": "Tag attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#89A889"
            }
        },
        {
            "name": "JSON key",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json"
            ],
            "settings": {
                "foreground": "#C0E3C0"
            }
        },
        {
            "name": "CSS property name",
            "scope": [
                "support.type.property-name.css",
                "meta.property-name.css"
            ],
            "settings": {
                "foreground": "#C0E3C0"
            }
        },
        {
            "name": "CSS value",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": {
                "foreground": "#F8F8F8"
            }
        },
        {
            "name": "Markdown heading",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#C0E3C0"
            }
        },
        {
            "name": "Markdown bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#F8F8F8"
            }
        },
        {
            "name": "Markdown italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#F8F8F8"
            }
        },
        {
            "name": "Markdown link",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#89A889"
            }
        },
        {
            "name": "Markdown inline code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#3FFABB"
            }
        },
        {
            "name": "Markdown quote",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#6B7280"
            }
        },
        {
            "name": "Diff inserted",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#3FFABB"
            }
        },
        {
            "name": "Diff deleted",
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#ED254E"
            }
        },
        {
            "name": "Diff changed",
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#FBBF24"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#ED254E"
            }
        },
        {
            "name": "Deprecated",
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "fontStyle": "strikethrough",
                "foreground": "#FB923C"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "meta.bracket",
                "meta.parens"
            ],
            "settings": {
                "foreground": "#6B7280"
            }
        },
        {
            "name": "Embedded punctuation (JSX/TSX braces)",
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": {
                "foreground": "#C0E3C0"
            }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#89A889",
        "type": "#89A889",
        "class": "#89A889",
        "interface": "#89A889",
        "enum": "#89A889",
        "typeParameter": "#89A889",
        "function": "#FBBF24",
        "method": "#FBBF24",
        "macro": "#FBBF24",
        "variable": "#F8F8F8",
        "parameter": "#F8F8F8",
        "property": "#F8F8F8",
        "enumMember": "#89A889",
        "event": "#FBBF24",
        "keyword": "#C0E3C0",
        "modifier": "#C0E3C0",
        "comment": {
            "foreground": "#6B7280",
            "fontStyle": "italic"
        },
        "string": "#3FFABB",
        "number": "#89A889",
        "regexp": "#FBBF24",
        "operator": "#A2B0FF",
        "decorator": {
            "foreground": "#FBBF24",
            "fontStyle": "italic"
        },
        "*.deprecated": {
            "fontStyle": "strikethrough"
        },
        "*.readonly": {
            "fontStyle": "italic"
        }
    }
}
