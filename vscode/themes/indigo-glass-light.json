    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#6B7280"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#07080A"
            }
        },
        {
            "name": "Variable language (this/self)",
            "scope": [
                "variable.language",
                "variable.language.this"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#7C3AED"
            }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "constant.language",
                "constant.numeric",
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#7C3AED"
            }
        },
        {
            "name": "Boolean / null",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": {
                "foreground": "#7C3AED"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted"
            ],
            "settings": {
                "foreground": "#15803D"
            }
        },
        {
            "name": "String escape",
            "scope": [
                "constant.character.escape",
                "string.regexp"
            ],
            "settings": {
                "foreground": "#B45309"
            }
        },
        {
            "name": "Template expression punctuation",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": {
                "foreground": "#4D6D4E"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new"
            ],
            "settings": {
                "foreground": "#4D6D4E"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "punctuation.separator"
            ],
            "settings": {
                "foreground": "#1E40AF"
            }
        },
        {
            "name": "Storage (var/let/const/function/class)",
            "scope": [
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#4D6D4E"
            }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function",
                "meta.definition.method entity.name.function"
            ],
            "settings": {
                "foreground": "#B45309"
            }
        },
        {
            "name": "Class / Type",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#7C3AED"
            }
        },
        {
            "name": "Namespace / Module",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "support.module"
            ],
            "settings": {
                "foreground": "#7C3AED"
            }
        },
        {
            "name": "Decorator",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#B45309"
            }
        },
        {
            "name": "Property / member",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.property.object",
                "support.variable.property"
            ],
            "settings": {
                "foreground": "#07080A"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#4D6D4E"
            }
        },
        {
            "name": "Tag attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#7C3AED"
            }
        },
        {
            "name": "JSON key",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json"
            ],
            "settings": {
                "foreground": "#4D6D4E"
            }
        },
        {
            "name": "CSS property name",
            "scope": [
                "support.type.property-name.css",
                "meta.property-name.css"
            ],
            "settings": {
                "foreground": "#4D6D4E"
            }
        },
        {
            "name": "CSS value",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": {
                "foreground": "#07080A"
            }
        },
        {
            "name": "Markdown heading",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#4D6D4E"
            }
        },
        {
            "name": "Markdown bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#07080A"
            }
        },
        {
            "name": "Markdown italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#07080A"
            }
        },
        {
            "name": "Markdown link",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#7C3AED"
            }
        },
        {
            "name": "Markdown inline code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#15803D"
            }
        },
        {
            "name": "Markdown quote",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#6B7280"
            }
        },
        {
            "name": "Diff inserted",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#15803D"
            }
        },
        {
            "name": "Diff deleted",
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#C81D45"
            }
        },
        {
            "name": "Diff changed",
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#B45309"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#C81D45"
            }
        },
        {
            "name": "Deprecated",
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "fontStyle": "strikethrough",
                "foreground": "#EA580C"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "meta.bracket",
                "meta.parens"
            ],
            "settings": {
                "foreground": "#6B7280"
            }
        },
        {
            "name": "Embedded punctuation (JSX/TSX braces)",
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": {
                "foreground": "#4D6D4E"
            }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#7C3AED",
        "type": "#7C3AED",
        "class": "#7C3AED",
        "interface": "#7C3AED",
        "enum": "#7C3AED",
        "typeParameter": "#7C3AED",
        "function": "#B45309",
        "method": "#B45309",
        "macro": "#B45309",
        "variable": "#07080A",
        "parameter": "#07080A",
        "property": "#07080A",
        "enumMember": "#7C3AED",
        "event": "#B45309",
        "keyword": "#4D6D4E",
        "modifier": "#4D6D4E",
        "comment": {
            "foreground": "#6B7280",
            "fontStyle": "italic"
        },
        "string": "#15803D",
        "number": "#7C3AED",
        "regexp": "#B45309",
        "operator": "#1E40AF",
        "decorator": {
            "foreground": "#B45309",
            "fontStyle": "italic"
        },
        "*.deprecated": {
            "fontStyle": "strikethrough"
        },
        "*.readonly": {
            "fontStyle": "italic"
        }
    }
}
