{
  "// Indigo Glass — recommended settings (paste into ~/.config/Code/User/settings.json)": "",

  "workbench.colorTheme": "Indigo Glass Dark",
  "workbench.preferredDarkColorTheme": "Indigo Glass Dark",
  "workbench.preferredLightColorTheme": "Indigo Glass Light",
  "window.autoDetectColorScheme": true,

  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,

  "editor.fontLigatures": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.size": "proportional",
  "editor.minimap.scale": 1,
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "selection",
  "editor.scrollbar.verticalScrollbarSize": 10,
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "editor.padding.top": 12,
  "editor.padding.bottom": 12,

  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.list.horizontalScrolling": false,
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.decorations.colors": true,
  "workbench.editor.decorations.badges": true,
  "workbench.activityBar.location": "default",
  "workbench.statusBar.visible": true,
  "workbench.sideBar.location": "left",

  "breadcrumbs.enabled": true,
  "breadcrumbs.icons": true,

  "// Match the canonical Indigo Glass terminal cursor": "block + smooth",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",

  "// Monospace font intentionally NOT set — keep user choice": ""
}
