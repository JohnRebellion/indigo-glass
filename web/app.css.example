/* Sage Ink — Portfolio Design System
 * Neobrutalist ink: opaque flat surfaces, colour-as-elevation, hard offset
 * shadow (zero blur), mechanical press. No glass, no blur, no neumorphism.
 *
 * Schema: this file follows the neobrutalism.dev customizer output format
 * (github.com/ekmas/neobrutalism-components) verbatim — same variable names
 * (--main / --border / --shadow / --background / --secondary-background /
 * --foreground / --main-foreground / --ring / --overlay / --chart-*), same
 * @theme inline mapping, same font-weight + boxShadow spacing tokens. Only
 * the hue is changed: --main is Sage Ink's accent (OKLCH hue 145°) instead
 * of the customizer's amber (hue ~84°). Colours derive from
 * tokens/indigo-glass.tokens.toml [variants.sage].
 *
 * Dark-only: Sage Ink defines no light variant (tokens.toml has one surface
 * ladder, opacity.window_active=1.00). :root carries the dark palette
 * directly rather than shipping an unused light block + .dark override.
 *
 * NOTE on --border and --shadow (rewritten 2026-09-02): this file used to
 * follow the reference schema literally — both pure black — on the grounds
 * that matching the customizer was the point. Measured, that was not a
 * divergence but a non-implementation: on #07080A a black stroke scores
 * 1.08:1 and a black shadow 1.05:1. Neither is visible.
 *
 * The rules, settled by cross-model audit (see
 * research-reports/neobrutalism-page-audit-2026-09-02/):
 *
 *   --border  must survive against BOTH the fill it encloses and the backdrop
 *             behind it. On dark: the lifted neutral. Black only where fill
 *             AND backdrop are light.
 *   --shadow  is the inverse tone of the element's OWN fill, because a shadow
 *             reads as a displaced copy of the object casting it. Dark fill ->
 *             sage. Light fill (bg-main, amber, positive) -> the page colour.
 *
 * This is why the reference gets away with one colour: every fill in
 * neobrutalism.dev is light, so black always contrasts. Sage Ink has fills on
 * both sides of the threshold and needs both tones.
 */

@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

:root {
  /* Surfaces — Sage Ink's deep near-black ladder (tokens.toml [variants.sage]).
     --background is the page; --secondary-background is the lifted control /
     card fill the reference uses for its neutral variant. */
  --background: oklch(13.40% 0.0051 262.32);            /* #07080A base */
  --secondary-background: oklch(18.40% 0.0081 285.58);  /* #121216 surface_alt */
  --foreground: oklch(97.91% 0.0000 89.88);             /* #F8F8F8 text */
  --main-foreground: oklch(13.40% 0.0051 262.32);       /* #07080A — dark text ON the sage fill */

  /* Accent — sage, hue 145°. Fill-only: sage cannot carry body text
     (1.72:1 vs --foreground), which is exactly why --main-foreground is the
     near-black above, matching the reference's dark-text-on-accent pairing. */
  --main: oklch(80.00% 0.0600 145.00);                  /* #A6C9A6 accent */

  /* border_strong, white at 0.335 over surface. 3.10:1 against the page —
     black measured 1.08:1 and simply was not there. */
  --border: #5E5E60;
  --ring: oklch(100% 0 0);
  --overlay: oklch(0% 0 0 / 0.8);

  /* Default shadow is for DARK fills, which is most of them: sage accent_alt,
     7.66:1 against the page. Light fills override it below. */
  --shadow: 4px 4px 0px 0px #89A889;
  --shadow-on-light: 4px 4px 0px 0px var(--background);
  --border-on-light: #000000;

  /* Charts — sage-family first slot, then hues spaced far enough to stay
     distinguishable against it. chart-4 uses Sage Ink's own `positive`
     (hue 165°, nudged off 152.51° so it never reads as the accent). */
  --chart-1: #A6C9A6;
  --chart-2: #0099FF;
  --chart-3: #FF7A05;
  --chart-4: #3FFABB;
  --chart-5: #7A83FF;
  --chart-active-dot: #fff; /* was missing entirely - dark-only, so this matches the reference's .dark value */
}

@theme inline {
  --color-main: var(--main);
  --color-background: var(--background);
  --color-secondary-background: var(--secondary-background);
  --color-foreground: var(--foreground);
  --color-main-foreground: var(--main-foreground);
  --color-border: var(--border);
  --color-overlay: var(--overlay);
  --color-ring: var(--ring);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);

  --spacing-boxShadowX: 4px;
  --spacing-boxShadowY: 4px;
  --spacing-reverseBoxShadowX: -4px;
  --spacing-reverseBoxShadowY: -4px;
  --radius-base: 0px;
  --shadow-shadow: var(--shadow);
  --shadow-onLight: var(--shadow-on-light);
  --font-weight-base: 500;
  --font-weight-heading: 700;
}

@layer base {
  :root {
    color-scheme: dark;
  }

  body {
    @apply text-foreground font-base bg-background;
  }

  h1, h2, h3, h4, h5, h6 {
    @apply font-heading;
  }

  /* Tone context. A light-filled element casts the page colour, not sage:
     sage on the accent fill measures 1.44:1, the page colour 11.00:1. Set on
     the element itself — it declares the shadow IT casts — so unfilled
     children inherit the right tone from their effective fill. */
  .bg-main, .bg-amber, .bg-positive {
    --shadow: var(--shadow-on-light);
  }
  /* Black border only where the fill AND what is behind it are both light —
     the reference's own `focus:border-border` on `bg-main`. On the dark page
     a light fill keeps the neutral (3.00:1, against black's 1.08:1). */
  :is(.bg-main, .bg-amber, .bg-positive) :is(.bg-main, .bg-amber, .bg-positive) {
    --border: var(--border-on-light);
  }

  /* Solid outline only — no translucent glow/halo. Matches the reference's
     own focus-visible:ring-2 ring-ring/50 pattern in spirit (a ring around
     the element) but opaque throughout, consistent with border-border and
     --shadow both being solid, never a tinted wash. */
  *:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
}
