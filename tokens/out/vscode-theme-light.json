            ],
            "settings": {
                "foreground": "#007E52"
            }
        },
        {
            "name": "Markdown quote",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#5A5E67"
            }
        },
        {
            "name": "Diff inserted",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#007E52"
            }
        },
        {
            "name": "Diff deleted",
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#BE0C39"
            }
        },
        {
            "name": "Diff changed",
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#946900"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#BE0C39"
            }
        },
        {
            "name": "Deprecated",
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "fontStyle": "strikethrough",
                "foreground": "#AB571A"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "meta.bracket",
                "meta.parens"
            ],
            "settings": {
                "foreground": "#5A5E67"
            }
        },
        {
            "name": "Embedded punctuation (JSX/TSX braces)",
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": {
                "foreground": "#375538"
            }
        }
    ]
}
