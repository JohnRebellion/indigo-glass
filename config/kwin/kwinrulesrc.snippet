# Lime Glass — global window opacity rule
# Append to ~/.config/kwinrulesrc
# Replace UUID below with output of `uuidgen`
# Update [General] count + rules accordingly

[REPLACE-WITH-UUIDGEN-OUTPUT]
Description=Lime Glass — global window opacity
opacityactive=88
opacityactiverule=2
opacityinactive=85
opacityinactiverule=2
wmclass=.*
wmclassmatch=3
wmclasscomplete=false
