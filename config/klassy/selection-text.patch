     // scrollarea polishing is somewhat complex. It is moved to a dedicated method
     polishScrollArea(qobject_cast<QAbstractScrollArea *>(widget));
 
+    // Sage Ink: [Colors:Selection] foreground is now the TEXT colour (2026-09-22),
+    // because Kirigami/QML delegates paint selected labels in that role over an
+    // unfilled Tier C outline, and there is no QWidget for polish() to reach.
+    // Text selection in these editors is still a genuine sage FILL, so give it
+    // back whichever of Text/Base reads better against Highlight - dark ink on
+    // the dark variants, and still correct on the light ones.
+    if (qobject_cast<QLineEdit *>(widget) || qobject_cast<QTextEdit *>(widget) || qobject_cast<QPlainTextEdit *>(widget)) {
+        QPalette editPalette = widget->palette();
+        for (const auto group : {QPalette::Active, QPalette::Inactive}) {
+            const QColor fill = editPalette.color(group, QPalette::Highlight);
+            const QColor text = editPalette.color(group, QPalette::Text);
+            const QColor base = editPalette.color(group, QPalette::Base);
+            editPalette.setColor(group,
+                                 QPalette::HighlightedText,
+                                 KColorUtils::contrastRatio(text, fill) >= KColorUtils::contrastRatio(base, fill) ? text : base);
+        }
+        widget->setPalette(editPalette);
+    }
