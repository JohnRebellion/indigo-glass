{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "right": 2 },
    "color": { "1": "#818CF8" }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#818CF8",
      "title": "#A78BFA",
      "output": "#F8F8F8"
    },
    "key": { "width": 10 }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": { "user": "#A78BFA", "at": "#6B7280", "host": "#818CF8" }
    },
    {
      "type": "custom",
      "format": "─────────────────────────────"
    },
    { "type": "os",       "key": "  os" },
    { "type": "kernel",   "key": "  kr" },
    { "type": "uptime",   "key": "  up" },
    { "type": "packages", "key": " 󰏖 pk" },
    { "type": "shell",    "key": "  sh" },
    { "type": "de",       "key": "  de" },
    { "type": "wm",       "key": "  wm" },
    { "type": "terminal", "key": "  tm" },
    { "type": "cpu",      "key": "  cp" },
    { "type": "gpu",      "key": " 󰍛 gp" },
    { "type": "memory",   "key": "  mm" },
    { "type": "display",  "key": " 󰍹 ds" },
    {
      "type": "custom",
      "format": "─────────────────────────────"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
