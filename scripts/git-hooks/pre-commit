#!/usr/bin/env bash
# Sage Ink pre-commit: block a commit that introduces palette/material/alpha/
# parity drift. Added 2026-09-01 after a cross-model audit found the drift
# guard was accurate but purely manual — it only ever caught what someone
# remembered to run it against.
#
# Fast (sub-second on this repo's size); does not scan the whole tree, only
# whatever check-palette-drift.sh already scans by design.
#
# Bypass for emergency/WIP commits: git commit --no-verify
REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- author identity -------------------------------------------------------
# Added 2026-09-22. This is a personal repo and its commits are supposed to
# carry the personal identity, but 6bf824d landed with the employer address and
# was pushed before anyone noticed — a rule that lived only in prose. The drift
# guard below proves hooks work here; authorship just had nothing watching it.
#
# git var resolves the identity the commit will ACTUALLY use, including a
# -c user.email= override or GIT_AUTHOR_EMAIL in the environment, which is how
# the bad commit was made. Reading git config would miss both.
AUTHOR_EMAIL="$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')"
case "$AUTHOR_EMAIL" in
  johnnecirrebellion@gmail.com|*+JohnRebellion@users.noreply.github.com) ;;
  *)
    echo "[pre-commit] author email '$AUTHOR_EMAIL' is not the personal identity." >&2
    echo "  This repo commits as John Rebellion <johnnecirrebellion@gmail.com>." >&2
    echo "  Let git use the configured identity - do not pass -c user.email=." >&2
    echo "  Bypass for a deliberate exception: git commit --no-verify" >&2
    exit 1
    ;;
esac
"$REPO_ROOT/scripts/check-palette-drift.sh" || {
  echo "" >&2
  echo "[pre-commit] drift guard failed — commit blocked." >&2
  echo "  Fix the drift above, or bypass with: git commit --no-verify" >&2
  exit 1
}

# Ink contract: translucent shadows, invisible borders, invented colours and
# 1px control borders all pass the hex-only drift guard above. Added
# 2026-09-22 after a live audit found every one of them shipping in GTK.
python3 "$REPO_ROOT/scripts/check-ink-contract.py" || {
  echo "" >&2
  echo "[pre-commit] ink contract failed — commit blocked." >&2
  echo "  Fix the violations above, or bypass with: git commit --no-verify" >&2
  exit 1
}
