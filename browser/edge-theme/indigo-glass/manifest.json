{
  "manifest_version": 3,
  "name": "Lime Glass — Edge Theme",
  "short_name": "Lime Glass",
  "version": "1.1.0",
  "description": "Aligns Edge chrome (frame, toolbar, tabs, NTP) to Lime Glass tokens. Eliminates the color seam between Klassy/KWin titlebar and Edge nav bar.",
  "author": "John Rebellion",
  "theme": {
    "colors": {
      "frame":                     [31, 32, 40],
      "frame_inactive":            [28, 28, 33],
      "frame_incognito":           [24, 24, 28],
      "frame_incognito_inactive":  [21, 21, 25],

      "toolbar":                   [31, 32, 40],
      "toolbar_text":              [248, 248, 248],

      "tab_text":                  [248, 248, 248],
      "tab_background_text":       [165, 169, 178],
      "tab_background_text_inactive": [120, 122, 130],

      "bookmark_text":             [248, 248, 248],

      "omnibox_background":        [15, 15, 18],
      "omnibox_text":              [248, 248, 248],

      "ntp_background":            [15, 15, 18],
      "ntp_text":                  [248, 248, 248],
      "ntp_link":                  [129, 140, 248],

      "button_background":         [31, 32, 40]
    },
    "tints": {
      "buttons":           [0.65, 0.90, 0.74],
      "frame":             [-1, -1, -1],
      "background_tab":    [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "center"
    }
  }
}
